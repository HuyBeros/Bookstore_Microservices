# Copy to .env and set the three required secrets before starting.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=QLBookStore
# Base64 of at least 32 random bytes; shared by all services for local integration.
JWT_SECRET=
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=bookstore
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@bookstore.com
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_ENABLED=true
CATALOG_URL=http://localhost:8082
INVENTORY_URL=http://localhost:8084
INVENTORY_MOCK=false
SPRING_PROFILES_ACTIVE=dev
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional. With no Gemini key, AI uses its existing fallback behavior.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional dedicated vector store; never use VITE_* for AI secrets.
AI_RAG_ENABLED=true
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSION=768
AI_VECTOR_DB_URL=jdbc:postgresql://localhost:5433/bookstore_vectors?connectTimeout=2&socketTimeout=5
AI_INDEX_INTERVAL_MS=600000
